[Unit]
Description=MongoDB Manager Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mongodb-manager
Group=mongodb-manager
WorkingDirectory=/opt/mongodb-manager
Environment=MONGO_MANAGER_DATA=/var/lib/mongodb-manager-web
ExecStart=/opt/mongodb-manager/.venv/bin/python -m uvicorn web.app:app --host 127.0.0.1 --port 8765 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1,::1
Restart=on-failure
RestartSec=5
UMask=0077
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
